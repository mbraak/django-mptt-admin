{
    "name": "django-mptt-admin",
    "version": "1.0.0",
    "description": "Frontend code for django-mptt-admin",
    "main": "index.js",
    "scripts": {
        "build": "pnpm run sass && pnpm run build_javascript && pnpm run copy_jqtree_map_files",
        "build_javascript": "rollup -c",
        "copy_jqtree_map_files": "cp node_modules/jqtree/*.map ../django_mptt_admin/static/django_mptt_admin/",
        "sass": "sass django_mptt_admin.scss ../django_mptt_admin/static/django_mptt_admin/django_mptt_admin.css",
        "watch": "rollup -c -w",
        "lint": "eslint src",
        "test": "vitest --watch=false",
        "test:coverage": "vitest run --coverage",
        "test:watch": "vitest",
        "tsc": "tsc --build",
        "ci": "pnpm run lint && pnpm run tsc && pnpm run test"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/mbraak/django-mptt-admin.git"
    },
    "author": "",
    "license": "Apache-2.0",
    "bugs": {
        "url": "https://github.com/mbraak/django-mptt-admin/issues"
    },
    "homepage": "https://github.com/mbraak/django-mptt-admin#readme",
    "peerDependencies": {
        "jquery": ">= 3"
    },
    "devDependencies": {
        "@babel/core": "^8.0.1",
        "@babel/preset-env": "^8.0.2",
        "@babel/preset-typescript": "^8.0.1",
        "@eslint/js": "^10.0.1",
        "@rollup/plugin-babel": "^7.1.0",
        "@rollup/plugin-commonjs": "^29.0.3",
        "@rollup/plugin-node-resolve": "^16.0.3",
        "@rollup/plugin-terser": "^1.0.0",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^7.0.1",
        "@types/jquery": "^4.0.1",
        "@types/js-cookie": "^3.0.6",
        "@types/node": "^26.4.1",
        "@vitest/coverage-istanbul": "^5",
        "@vitest/eslint-plugin": "^1.6.27",
        "babel-plugin-istanbul": "^8.0.0",
        "eslint": "^10.9.1",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import-x": "^4.17.1",
        "eslint-plugin-perfectionist": "^5.11.0",
        "jsdom": "^30.0.1",
        "msw": "^2.15.0",
        "rollup": "^4.63.1",
        "sass": "^1.103.1",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.69.0",
        "vitest": "^5"
    },
    "dependencies": {
        "jqtree": "^1.9.0",
        "js-cookie": "^3.0.8"
    }
}
