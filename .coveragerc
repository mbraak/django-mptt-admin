[run]
branch = True
# Measure the test worker processes when running the tests with --parallel
concurrency = multiprocessing,thread
parallel = True
source =
  django_mptt_admin
  django_mptt_example
omit =
  */django_mptt_example/tests/base_playwright_testcase.py
  */django_mptt_example/tests/playwright_page.py
  */django_mptt_example/tests/test_playwright.py
